{
  "name": "catalina-support",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node --test scripts/check-boundaries.test.mjs",
    "prebuild": "npm run check:boundaries && npm run test:boundaries",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run check:boundaries && npm run test:boundaries",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
