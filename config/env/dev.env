# Entorno de desarrollo. Este archivo SÍ se versiona porque no contiene secretos
# reales: la contraseña de la base de datos es la de un contenedor local.
#
# Los nombres POSTGRES_* los consume la imagen oficial de PostgreSQL por sí sola;
# PGPORT lo comparten la imagen y el backend (una sola variable, un solo valor).
# ENVIRONMENT, PROJECT_NAME, LOGS_FOLDER y TIMEZONE son de go-logs (docs/arquitectura.md).

ENVIRONMENT=dev
PROJECT_NAME=catalina-support
LOGS_FOLDER=/logs
TIMEZONE=UTC-5

APP_PORT=11002

# Secreto con el que se firma el token de sesión. En desarrollo es un valor de casa; en producción
# es obligatorio y el backend no arranca sin él (docs/modules/auth.md, sección 3).
TOKEN_SECRET=922e915370685ac1352594cabc3423fe8dccbdee205b22b12b6f4e84a8e6c262

# Base de los enlaces que van en los correos (establecer contraseña, abrir un ticket).
# Nunca un host escrito a mano en una plantilla: docs/modules/mail.md, sección 4.
PUBLIC_APP_URL=https://dev.catalina-support.example.com

# Contraseña de la cuenta de administrador de fábrica (usuario `admin`): es una credencial
# de contenedor local, como la de PostgreSQL, así que se versiona. En producción es
# obligatoria y vive sólo en config/env/prod.env (docs/usuarios-y-permisos.md, sección 8).
ADMIN_PASSWORD=admin

# El correo saliente **ya no es una variable de entorno**: vive en la base, lo pide la vista de
# primer arranque y se cambia en Configuración (docs/primer-arranque.md, sección 5).

# Adjuntos de los tickets: carpeta dentro del contenedor (volumen `_files` montado
# desde ./_files). docs/tickets.md, sección 2.3.
FILES_PATH=/files

# Correo saliente. Son los siete avisos de ticket más los tres correos de cuenta
# (docs/arquitectura.md, sección 9). Si quedan vacíos, el correo falla con un error
# claro y la acción se hace igual; pero sin SMTP no se puede completar el alta de una
# cuenta local, porque la contraseña se establece desde el correo.
#
# En desarrollo apunta al buzón de pruebas (`mail` en dev.yml): todo lo que salga se lee
# en http://127.0.0.1:11004, con su HTML y su versión de texto. No sale nada a internet.
# El motor de IA que redacta el motivo y la última acción del ticket (docs/modules/ai.md).
# Es **opcional**: sin esta variable la aplicación funciona igual y los dos campos se quedan
# sin texto. El motor vive en su propio contenedor (`ai.yml`) y se habla por la red interna.
AI_URL=http://ai:8080
AI_MODEL=qwen2.5-1.5b-instruct
AI_PALABRAS=40
AI_ESPERA_SEGUNDOS=240


POSTGRES_HOST=database
PGPORT=11003
POSTGRES_USER=catalina_support
POSTGRES_PASSWORD=catalina_support
POSTGRES_DB=catalina_support

# ---------------------------------------------------------------------------------------------
# Los dos caminos de directorio —el de AD y el de Keycloak— **ya no se configuran aquí**.
#
# Viven en la base (las tablas `directory_settings` y `keycloak_settings`) y se cambian desde la
# pantalla de Configuración, con su botón de «Probar la conexión»
# (docs/modules/settings.md, sección 5.8). En desarrollo los deja puestos `./scripts/dev-seed.sh`,
# apuntando a los dos servicios de pruebas que viven en `dev.yml` detrás del perfil `auth`:
#
#   docker compose -f dev.yml --profile auth up -d
#
# Y el método de entrada se queda en `local`: cambiar a `ad` o a `keycloak` se hace desde
# Configuración, y **con uno puesto los otros dos quedan apagados**. La cuenta de fábrica entra
# siempre, sea cual sea el método.
# ---------------------------------------------------------------------------------------------

# La contraseña del administrador de Keycloak, que sólo la usa el contenedor del reino de pruebas.
KEYCLOAK_ADMIN_PASSWORD=admin-keycloak
