# Plantilla del entorno de producción.
#
# Uso: copiar a config/env/prod.env y rellenar los valores reales.
# config/env/prod.env NO se versiona (.gitignore): lleva contraseñas de verdad.
#
# El dominio, el TLS y los pasos de despliegue se documentan en docs/ambientes.md
# antes de desplegar nada (docs/arquitectura.md, sección 9).

ENVIRONMENT=prod
PROJECT_NAME=catalina-support
LOGS_FOLDER=/logs
TIMEZONE=UTC-5

APP_PORT=21002

# OBLIGATORIA: secreto con el que se firma el token de sesión. Genéralo con:
#   openssl rand -hex 32
TOKEN_SECRET=cambiar

# OBLIGATORIA: base de los enlaces de los correos.
PUBLIC_APP_URL=https://catalina-support.calibyou.com

# Contraseña de la cuenta `admin`. OBLIGATORIA: sin ella el backend no arranca.
# El valor real NO se versiona; se pone en config/env/prod.env.
ADMIN_PASSWORD=cambiar

# El correo saliente **ya no es una variable de entorno**: vive en la base, lo pide la vista de
# primer arranque y se cambia en Configuración (docs/primer-arranque.md, sección 5).

FILES_PATH=/files

# El motor de IA (docs/modules/ai.md). En producción apunta al contenedor compartido; si se deja
# vacío, los dos campos se quedan sin texto y la aplicación funciona igual.
AI_URL=http://catalina_support_ai:8080
AI_MODEL=qwen2.5-1.5b-instruct
AI_PALABRAS=40
AI_ESPERA_SEGUNDOS=240


POSTGRES_HOST=database
PGPORT=21003
POSTGRES_USER=cambiar
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=catalina_support

# ---------------------------------------------------------------------------------------------
# Los dos caminos de directorio —el de AD y el de Keycloak— **no se configuran aquí**.
#
# Viven en la base (las tablas `directory_settings` y `keycloak_settings`) y se cambian desde la
# pantalla de Configuración de la instalación, con su botón de «Probar la conexión»
# (docs/modules/settings.md, sección 5.8). En una instalación recién puesta vienen vacíos y el método
# de entrada es `local`: la cuenta de fábrica entra siempre, y desde ella se configura el resto.
#
# **La contraseña de la cuenta de servicio y el secreto del cliente se guardan en la base y no salen
# nunca por la API**: la pantalla sólo dice si hay uno puesto. Van en la copia de seguridad de la base
# como cualquier otro dato, y por eso `scripts/backup-db.sh` no es opcional
# (docs/ambientes.md, sección 6).
# ---------------------------------------------------------------------------------------------

# La contraseña del administrador de Keycloak: sólo la usa el contenedor del reino, si es que esta
# instalación levanta uno. Con un Keycloak de la organización, no hace falta.
KEYCLOAK_ADMIN_PASSWORD=
