# Plantilla del entorno de producción.
#
# Uso: copiar a config/env/prod.env y rellenar los valores reales.
# config/env/prod.env NO se versiona (.gitignore): lleva contraseñas de verdad.
#
# El dominio, el TLS y los pasos de despliegue se documentan en docs/ambientes.md
# antes de desplegar nada (docs/arquitectura.md, sección 9).

ENVIRONMENT=prod
PROJECT_NAME=catalina-support
LOGS_FOLDER=/logs
TIMEZONE=UTC-5

APP_PORT=21002

# Contraseña de la cuenta `admin`. OBLIGATORIA: sin ella el backend no arranca.
# El valor real NO se versiona; se pone en config/env/prod.env.
ADMIN_PASSWORD=cambiar

FILES_PATH=/files

SMTP_HOST=cambiar
SMTP_PORT=587
SMTP_USER=cambiar
SMTP_PASSWORD=cambiar
SMTP_SECURE=true
SMTP_FROM_NAME=Catalina Support
SMTP_FROM_EMAIL=cambiar

POSTGRES_HOST=database
PGPORT=21003
POSTGRES_USER=cambiar
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=catalina_support
